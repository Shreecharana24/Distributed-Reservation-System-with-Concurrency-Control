# --- Project specific ignores ---

# SSL certificates (PRIVATE)
*.pem
*.key

# Database
*.db

# Local config
server_ip.txt

# Python virtual env (IMPORTANT - your case)
myenv/
*/myenv/

# Node build (already mostly covered but safe)
dist/
build/

# Vite cache
.vite/

# Logs
*.log

__pycache__/
*.py[codz]
